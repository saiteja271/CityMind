# CITYMIND Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development

# API Server
PORT=4000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/citymind

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Simulation Service
SIM_PORT=4001
SIMULATION_TICK_MS=1000
MAX_CITIZENS_PER_TICK=500

# Client
REACT_APP_API_URL=http://localhost:4000
REACT_APP_WS_URL=ws://localhost:4000
REACT_APP_DEFAULT_MAP_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Optional AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false
